#!/usr/bin/env bash
# Installs and configures HAProxy with round-robin load balancing for web-01 and web-02

apt-get update -y
apt-get install -y haproxy

echo "ENABLED=1" >> /etc/default/haproxy

cat << 'EOF' >> /etc/haproxy/haproxy.cfg

frontend http-in
	bind *:80
	mode http
	default_backend webservers

backend webservers
	balance roundrobin
	server 7236-web-01 18.171.241.16:80 check
	server 7236-web-02 18.171.209.89:80 check
EOF

service haproxy restart
