#!/usr/bin/env bash
# Installs Nginx, configures 301 redirect, and sets up a custom 404 page

apt-get update -y
apt-get install -y nginx

echo "Holberton School" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/custom_404.html

sed -i '/server_name _;/a \
\tlocation /redirect_me {\n\t\treturn 301 https://youtube.com;\n\t}\n\n\terror_page 404 /custom_404.html;\n\tlocation = /custom_404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}' /etc/nginx/sites-available/default

service nginx restart
