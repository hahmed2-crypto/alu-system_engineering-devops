#!/usr/bin/env bash
# Installs Nginx and configures /redirect_me to perform a 301 redirect

apt-get update -y
apt-get install -y nginx
mkdir -p /var/www/html
echo "Holberton School" > /var/www/html/index.html
sed -i "s|server_name _;|server_name _;\n\tlocation /redirect_me {\n\t\treturn 301 https://youtube.com;\n\t}|" /etc/nginx/sites-available/default
service nginx restart
